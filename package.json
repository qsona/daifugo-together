{
  "name": "daifugo-together",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0 && node scripts/check-ai-boundaries.mjs",
    "lint:design": "node scripts/check-design-tokens.mjs && node scripts/check-key-visual.mjs && node scripts/outline-key-visual.mjs --check",
    "ops": "pnpm --filter @daifugo/server ops:dev",
    "start": "pnpm --filter @daifugo/server start",
    "sync:production-proposals": "pnpm --filter @daifugo/server build && node scripts/sync-production-proposals.mjs",
    "test": "pnpm --filter @daifugo/ai... build && vitest run",
    "pretypecheck": "pnpm --filter @daifugo/core build",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "validate:ai": "pnpm --filter @daifugo/core build && pnpm --filter @daifugo/ai build && node scripts/validate-ai.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm lint:design && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.7.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.0.0",
    "sharp": "^0.35.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
