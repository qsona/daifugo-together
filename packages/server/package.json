{
  "name": "@daifugo/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @daifugo/ai... build && pnpm --filter @daifugo/rules build",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "pnpm --filter @daifugo/ai... build && pnpm --filter @daifugo/rules build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/bin.js",
    "ops": "node dist/ops.js",
    "ops:dev": "pnpm build && node dist/ops.js",
    "ops:status": "pnpm ops:dev status",
    "ops:funnel": "pnpm ops:dev funnel",
    "ops:metrics": "pnpm ops:dev metrics",
    "ops:dashboard": "pnpm build && node dist/ops-dashboard.js",
    "ops:list-appeals": "pnpm build && node dist/ops.js list-appeals",
    "ops:revoke-card": "pnpm build && node dist/ops.js revoke-card",
    "ops:reject-appeal": "pnpm build && node dist/ops.js reject-appeal",
    "ops:judge-eval": "pnpm build && node dist/judge-eval.js"
  },
  "dependencies": {
    "@daifugo/ai": "workspace:*",
    "@daifugo/core": "workspace:*",
    "@daifugo/rules": "workspace:*",
    "better-sqlite3": "13.0.1",
    "drizzle-orm": "0.45.2",
    "openid-client": "^6.8.4",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^26.0.0",
    "@types/web-push": "^3.6.4",
    "socket.io-client": "^4.8.3"
  }
}
