{
  "name": "@daifugo/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @daifugo/ai... build",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "pnpm --filter @daifugo/ai... build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@daifugo/ai": "workspace:*",
    "@daifugo/core": "workspace:*"
  }
}
