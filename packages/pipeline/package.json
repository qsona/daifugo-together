{
  "name": "@daifugo/pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @daifugo/server... build",
    "build": "tsc -p tsconfig.build.json",
    "confirm": "pnpm build && node dist/confirm.js",
    "pretypecheck": "pnpm --filter @daifugo/server... build",
    "judge": "pnpm build && node dist/judge.js",
    "judge:eval": "pnpm build && node dist/judge-eval.js",
    "implement": "pnpm build && node dist/implement-cli.js",
    "implement:resume": "pnpm build && node dist/implement-cli.js resume",
    "implement:retry": "pnpm build && node dist/implement-cli.js retry",
    "implement:fail": "pnpm build && node dist/implement-cli.js fail",
    "implement:checks": "pnpm build && node dist/ci-cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@daifugo/core": "workspace:*",
    "@daifugo/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.0.0"
  }
}
