{
  "name": "@daifugo/pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @daifugo/server... build",
    "build": "tsc -p tsconfig.build.json",
    "confirm": "node scripts/run-cli.mjs dist/confirm.js",
    "pretypecheck": "pnpm --filter @daifugo/server... build",
    "judge": "node scripts/run-cli.mjs dist/judge.js",
    "judge:eval": "node scripts/run-cli.mjs dist/judge-eval.js",
    "judge:review": "node scripts/run-cli.mjs dist/judge.js --review",
    "review": "node scripts/run-cli.mjs dist/review-cli.js",
    "implement": "node scripts/run-cli.mjs dist/implement-cli.js prepare",
    "implement:prepare": "node scripts/run-cli.mjs dist/implement-cli.js prepare",
    "implement:resume": "node scripts/run-cli.mjs dist/implement-cli.js prepare-resume",
    "implement:retry": "node scripts/run-cli.mjs dist/implement-cli.js prepare-retry",
    "implement:submit": "node scripts/run-cli.mjs dist/implement-cli.js submit",
    "implement:fail": "node scripts/run-cli.mjs dist/implement-cli.js fail",
    "implement:checks": "node scripts/run-cli.mjs dist/ci-cli.js",
    "implement:await-merge": "node scripts/run-cli.mjs dist/implement-cli.js await-merge",
    "implement:merged": "node scripts/run-cli.mjs dist/implement-cli.js merged",
    "implement:deploy": "node scripts/run-cli.mjs dist/implement-cli.js deploy",
    "implement:release-status": "node scripts/run-cli.mjs dist/implement-cli.js release-status",
    "implement:release": "node scripts/run-cli.mjs dist/implement-cli.js release",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@daifugo/core": "workspace:*",
    "@daifugo/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.0.0"
  }
}
