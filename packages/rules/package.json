{
  "name": "@daifugo/rules",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "generate:registry": "node scripts/generate-registry.mjs",
    "prebuild": "pnpm generate:registry",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "pnpm generate:registry",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@daifugo/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.0.0"
  }
}
